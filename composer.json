{
    "name": "websitinu/laravel-socialite-google-one-tap",
    "description": "A lightweight package to add Google One Tap login to Laravel applications using Socialite",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "google one tap",
        "laravel",
        "websitinu",
        "socialite",
        "login with google",
        "google sign-in"
    ],
    "homepage": "https://github.com/EhsanGhafoori/laravel-socialite-google-one-tap",
    "support": {
        "issues": "https://github.com/EhsanGhafoori/laravel-socialite-google-one-tap/issues",
        "source": "https://github.com/EhsanGhafoori/laravel-socialite-google-one-tap"
    },
    "autoload": {
        "psr-4": {
            "LaravelSocialite\\GoogleOneTap\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Ehsan Ghafoori",
            "email": "ehgh1996@gmail.com",
            "homepage": "https://github.com/EhsanGhafoori",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "google/apiclient": "^2.18",
        "socialiteproviders/manager": "^4.8"
    },
    "require-dev": {
        "orchestra/testbench": "^9.15|^10.8|^11.0",
        "pestphp/pest": "^3.0",
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "laravel/socialite": "Required to use this package (^5.0)"
    },
    "autoload-dev": {
        "psr-4": {
            "SocialiteProviders\\GoogleOneTap\\Tests\\": "tests"
        }
    },
    "scripts": {
        "google-task-composer-cleanup": "Google\\Task\\Composer::cleanup",
        "test": "./vendor/bin/pest",
        "test:lint": "composer validate --strict"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true,
        "audit": {
            "block-insecure": false
        }
    },
    "prefer-stable": true,
    "extra": {
        "google/apiclient-services": [
            "Oauth2"
        ]
    }
}
